      "section": null,
      "quote": null,
      "summary": "No express provision prevents release of a Borrower that ceases to be wholly owned. Borrowers are released when they cease to be Subsidiaries in a permitted transaction (Section 9.10(c)) or are designated Excluded Subsidiaries, subject to the investment cap.",
      "quote_verified": null
    },
    {
      "kind": "unrestricted_sub_cap",
      "present": "yes",
      "section": "Section 7.02(i)",
      "quote": "Investments in or for the benefit of Excluded Subsidiaries and Foreign Subsidiaries not to exceed $75,000,000 in the aggregate outstanding at any time",
      "summary": "Investments in Excluded Subsidiaries (the closest analogue to unrestricted subsidiaries) and Foreign Subsidiaries are capped at $75M outstanding, reduced by guarantees of Excluded Subsidiary debt. A Person cannot be designated an Excluded Subsidiary if that would exceed this cap or if a Default exists. Investments in a newly designated former Borrower are valued at book value less intercompany balances.",
      "quote_verified": true
    },
    {
      "kind": "addback_cap",
      "present": "yes",
      "section": "Section 1.01 (definitions of Consolidated EBITDA and Consolidated Adjusted Net Income)",
      "quote": "giving effect to any reasonably expected synergies in an amount not to exceed 15% of the Consolidated EBITDA of the Parent and its Subsidiaries (other than Excluded Subsidiaries), or such other amount as may be agreed between Parent and Administrative Agent",
      "summary": "Expected synergies from acquired businesses are capped at 15% of Consolidated EBITDA, though the Agent may agree a different amount. Severance and reorganization add-backs are capped at $10M cumulative from closing. There is no general add-back for projected cost savings.",
